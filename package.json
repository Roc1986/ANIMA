{
  "name": "anima",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "yarn workspace @anima/mobile start",
    "web": "yarn workspace @anima/web dev",
    "build:web": "yarn workspace @anima/web build",
    "build:shared": "yarn workspace @anima/shared build",
    "lint": "eslint '**/*.{ts,tsx}' --ignore-path .gitignore",
    "typecheck": "tsc --build"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "typescript": "^5.1.6"
  },
  "engines": {
    "node": ">=18.0.0",
    "yarn": ">=1.22.0"
  }
}
